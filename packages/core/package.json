{
  "name": "@siheom/core",
  "version": "0.3.0",
  "description": "Data-first frontend test interpreter (framework-agnostic core)",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/*.spec.tsx",
    "!src/**/__snapshots__/**",
    "!src/**/*.d.ts"
  ],
  "main": "./dist/esm/index.mjs",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./siheom": {
      "import": {
        "types": "./dist/esm/siheom.d.ts",
        "default": "./dist/esm/siheom.mjs"
      },
      "require": {
        "types": "./dist/cjs/siheom.d.cts",
        "default": "./dist/cjs/siheom.cjs"
      }
    },
    "./effect": {
      "import": {
        "types": "./dist/esm/effect.d.ts",
        "default": "./dist/esm/effect.mjs"
      },
      "require": {
        "types": "./dist/cjs/effect.d.cts",
        "default": "./dist/cjs/effect.cjs"
      }
    },
    "./with-fake-timers": {
      "import": {
        "types": "./dist/esm/withFakeTimers.d.ts",
        "default": "./dist/esm/withFakeTimers.mjs"
      },
      "require": {
        "types": "./dist/cjs/withFakeTimers.d.cts",
        "default": "./dist/cjs/withFakeTimers.cjs"
      }
    },
    "./aria-roles": {
      "import": {
        "types": "./dist/esm/a11y/ariaRoles.d.ts",
        "default": "./dist/esm/a11y/ariaRoles.mjs"
      },
      "require": {
        "types": "./dist/cjs/a11y/ariaRoles.d.cts",
        "default": "./dist/cjs/a11y/ariaRoles.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "siheom": [
        "./dist/esm/siheom.d.ts"
      ],
      "effect": [
        "./dist/esm/effect.d.ts"
      ],
      "with-fake-timers": [
        "./dist/esm/withFakeTimers.d.ts"
      ],
      "aria-roles": [
        "./dist/esm/a11y/ariaRoles.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && yarn node ../../scripts/validate-typescript-artifacts.mjs .",
    "check-exports": "bash ../../scripts/check-exports.sh .",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "aria-query": "^5.3.2",
    "dom-accessibility-api": "^0.7.1"
  },
  "peerDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0 || ^7.0.0",
    "@testing-library/user-event": "^14.0.0",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/aria-query": "^5.0.4",
    "@types/node": "^24.13.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "playwright": "^1.62.1",
    "tsconfig-custom": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinstae/siheom-ts.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/twinstae/siheom-ts",
  "bugs": {
    "url": "https://github.com/twinstae/siheom-ts/issues"
  },
  "author": "Taehee Kim <rabolution@gmail.com> (https://x.com/stelo_kim)"
}
