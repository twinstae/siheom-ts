{
  "name": "@siheom/virtual-screen-reader",
  "version": "0.3.0",
  "description": "Virtual screen reader (guidepup) registries for siheom — givens, effects, and assertions over the spoken phrase log",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/*.spec.tsx",
    "!src/**/__snapshots__/**",
    "!src/**/*.d.ts",
    "!src/testHelpers.ts",
    "!src/testSetup.ts"
  ],
  "main": "./dist/esm/index.mjs",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown && yarn node ../../scripts/validate-typescript-artifacts.mjs .",
    "check-exports": "bash ../../scripts/check-exports.sh .",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@guidepup/virtual-screen-reader": "^0.32.1",
    "@siheom/core": "workspace:*"
  },
  "peerDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@vitest/browser": "^4.1.10",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^24.13.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "playwright": "^1.61.1",
    "tsconfig-custom": "workspace:*",
    "tsdown": "^0.22.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinstae/siheom-ts.git",
    "directory": "packages/virtual-screen-reader"
  },
  "homepage": "https://github.com/twinstae/siheom-ts",
  "bugs": {
    "url": "https://github.com/twinstae/siheom-ts/issues"
  },
  "author": "Taehee Kim <rabolution@gmail.com> (https://x.com/stelo_kim)",
  "keywords": [
    "test",
    "testing-library",
    "screen-reader",
    "a11y",
    "accessibility",
    "guidepup",
    "typescript",
    "vitest"
  ]
}
