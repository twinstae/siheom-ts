{
  "name": "@siheom/ime",
  "version": "0.3.0",
  "description": "IME composition emulation for siheom (Hangul-first)",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "fixtures",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/*.spec.tsx",
    "!src/**/__snapshots__/**",
    "!src/**/*.d.ts"
  ],
  "main": "./dist/esm/index.mjs",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./hanja": {
      "import": {
        "types": "./dist/esm/hanja.d.ts",
        "default": "./dist/esm/hanja.mjs"
      },
      "require": {
        "types": "./dist/cjs/hanja.d.cts",
        "default": "./dist/cjs/hanja.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "hanja": [
        "./dist/esm/hanja.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && yarn node ../../scripts/validate-typescript-artifacts.mjs .",
    "check-exports": "bash ../../scripts/check-exports.sh .",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@siheom/core": "workspace:*",
    "es-hangul": "^2.4.0"
  },
  "peerDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0 || ^7.0.0",
    "@testing-library/user-event": "^14.0.0",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "playwright": "^1.62.1",
    "tsconfig-custom": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinstae/siheom-ts.git",
    "directory": "packages/ime"
  },
  "homepage": "https://github.com/twinstae/siheom-ts",
  "bugs": {
    "url": "https://github.com/twinstae/siheom-ts/issues"
  },
  "author": "Taehee Kim <rabolution@gmail.com> (https://x.com/stelo_kim)",
  "keywords": [
    "test",
    "testing-library",
    "ime",
    "hangul",
    "typescript"
  ]
}
