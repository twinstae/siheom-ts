generic:
  - interaction: [focused=true]
  button: "열기"
    - states: [expanded=false]
    - interaction: [focusable=true] [tabbable=true]
    - properties: [haspopup=true]
  button: "메뉴"
    - states: [expanded=true]
    - interaction: [focusable=true] [tabbable=true]
    - properties: [haspopup="menu"]
  menu: "동작"
    menuitem: "복사"
    menuitemcheckbox: "줄바꿈"
      - states: [checked=true]
    menuitemradio: "왼쪽"
      - states: [checked=false]
