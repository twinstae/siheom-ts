generic:
  - interaction: [focused=true]
  "도시"
  combobox: "도시"
    - states: [expanded=true]
    - properties: [autocomplete="list"] [haspopup="listbox"]
    - relations:
      activedescendant: "서울" (#city-seoul)
      controls: "도시 목록" (#city-list)
    "서울"
  listbox: "도시 목록"
    option: "서울"
      - states: [selected=true]
    option: "부산"
      - states: [selected=false]
