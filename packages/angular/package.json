{
  "name": "@siheom/angular",
  "version": "0.3.0",
  "description": "Angular runtime for siheom (data-first frontend test interpreter)",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/*.spec.tsx",
    "!src/**/__snapshots__/**",
    "!src/**/*.d.ts"
  ],
  "main": "./dist/esm/index.mjs",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown && yarn node ../../scripts/validate-typescript-artifacts.mjs .",
    "check-exports": "bash ../../scripts/check-exports.sh .",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@siheom/core": "workspace:*",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@testing-library/angular": "^19.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0 || ^7.0.0",
    "@testing-library/user-event": "^14.0.0",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/platform-browser-dynamic": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/angular": "^19.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.61.1",
    "rxjs": "^7.8.2",
    "tsconfig-custom": "workspace:*",
    "tsdown": "^0.22.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinstae/siheom-ts.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/twinstae/siheom-ts",
  "bugs": {
    "url": "https://github.com/twinstae/siheom-ts/issues"
  },
  "author": "Taehee Kim <rabolution@gmail.com> (https://x.com/stelo_kim)",
  "keywords": [
    "test",
    "testing-library",
    "angular",
    "typescript"
  ]
}
