{
  "name": "@siheom/react-native",
  "version": "0.3.0",
  "description": "React Native runtime for siheom (data-first frontend test interpreter)",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/*.spec.tsx",
    "!src/**/__snapshots__/**",
    "!src/**/*.d.ts"
  ],
  "main": "./dist/esm/index.mjs",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown && yarn node ../../scripts/validate-typescript-artifacts.mjs .",
    "check-exports": "bash ../../scripts/check-exports.sh .",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@siheom/core": "workspace:*"
  },
  "peerDependencies": {
    "@testing-library/react-native": "^14.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.81.0",
    "test-renderer": "^1.2.0",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.26.0",
    "@react-native/babel-preset": "0.86.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react-native": "^14.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-native": "0.86.0",
    "test-renderer": "^1.2.0",
    "tsconfig-custom": "workspace:*",
    "tsdown": "^0.22.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vitest-native": "^0.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinstae/siheom-ts.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/twinstae/siheom-ts",
  "bugs": {
    "url": "https://github.com/twinstae/siheom-ts/issues"
  },
  "author": "Taehee Kim <rabolution@gmail.com> (https://x.com/stelo_kim)",
  "keywords": [
    "test",
    "testing-library",
    "react-native",
    "typescript"
  ]
}
